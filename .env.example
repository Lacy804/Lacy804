# Identifier for this client's deployment (shows in /api/health). Optional but recommended
# so you can confirm at a glance which client's data this deployment serves.
CLIENT_NAME=ironcladpm

# Google OAuth 2.0 client credentials (from Google Cloud Console → APIs & Services → Credentials).
# These can be SHARED across all client deployments — one OAuth client app, many refresh tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token from `npm run get-token` (one-time setup, see README)
GOOGLE_REFRESH_TOKEN=

# GSC property URL. Use either:
#   sc-domain:ironcladpm.com           (domain property — captures http/https/www variants)
#   https://ironcladpm.com/            (URL-prefix property — exact match only)
GSC_SITE_URL=sc-domain:ironcladpm.com

# Comma-separated list of origins allowed to embed the API responses.
# Example: https://clearleaddigital.com,https://www.clearleaddigital.com,https://preview--your-app.lovable.app
ALLOWED_ORIGINS=https://clearleaddigital.com,https://www.clearleaddigital.com
